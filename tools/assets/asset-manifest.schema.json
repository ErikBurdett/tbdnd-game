{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ancient-world-strategy/asset-manifest.schema.json",
  "title": "Ancient World Strategy Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "sourceFiles",
          "runtimeFiles",
          "sheet",
          "pivot",
          "frames",
          "animations",
          "atlasGroup",
          "palettePolicy",
          "licenseRecordId",
          "importer",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "category": { "type": "string", "minLength": 1 },
          "sourceFiles": { "$ref": "#/$defs/files" },
          "runtimeFiles": { "$ref": "#/$defs/files" },
          "sheet": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "frameWidth",
              "frameHeight",
              "frameCount",
              "padding",
              "extrusion"
            ],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "frameWidth": { "type": "integer", "minimum": 1 },
              "frameHeight": { "type": "integer", "minimum": 1 },
              "frameCount": { "type": "integer", "minimum": 1 },
              "padding": { "type": "integer", "minimum": 0 },
              "extrusion": { "type": "integer", "minimum": 0 }
            }
          },
          "pivot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "index"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "index": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "animations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "frameNames", "framesPerSecond", "loop"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "frameNames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "framesPerSecond": { "type": "number", "exclusiveMinimum": 0 },
                "loop": { "type": "boolean" }
              }
            }
          },
          "atlasGroup": { "type": "string", "minLength": 1 },
          "palettePolicy": { "type": "string", "minLength": 1 },
          "licenseRecordId": { "type": "string", "minLength": 1 },
          "importer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
