{
  "name": "ancient-world-strategy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ancient/client",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @ancient/client e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "content:references": "node scripts/validate-content-references.mjs",
    "content:validate": "pnpm --filter @ancient/game-data validate",
    "map:build": "node tools/map/build-earth-84bce.mjs",
    "assets:validate": "node tools/assets/validate-manifest.mjs art/asset-manifest.example.json",
    "architecture:check": "node scripts/check-architecture.mjs",
    "kit:verify": "node scripts/verify-kit.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm kit:verify && pnpm architecture:check && pnpm assets:validate && pnpm content:references && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && node scripts/clean.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  }
}
